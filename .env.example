# Copy this file to ".env" (same folder as this file) and edit. Real environment variables override it.
# Paths are written exactly as Windows shows them: no quotes needed, no doubled backslashes.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://invoiceops:CHANGE_ME@localhost:5432/invoiceops
DATA_DIR=./data

# --- Security ---
# Leave empty on a single-user PC (server only listens on 127.0.0.1). Set any long random string to require a token.
ADMIN_TOKEN=
# 0 = keep jobs until you delete them. N = automatically delete jobs older than N days (checked at startup).
RETENTION_DAYS=0
MAX_UPLOAD_MB=50
MAX_ZIP_FILES=1000
MAX_ZIP_UNCOMPRESSED_MB=2000
PROCESSING_WORKERS=2

# --- OCR (PaddleOCR PP-OCRv6 Medium) ---
# Folder containing PP-OCRv6_medium_det and PP-OCRv6_medium_rec.
# Leave empty to use %LOCALAPPDATA%\InvoiceOps\paddle_models (run scripts\download_models.bat).
PADDLE_MODEL_DIR=
PADDLE_DEVICE=cpu
# Folder containing pdftoppm.exe (Poppler). Needed to render scanned PDFs.
POPPLER_PATH=C:\poppler\Library\bin
# Informational scope labels; PP-OCRv6 Medium is one multilingual model.
OCR_LANGUAGES=eng
OCR_TIMEOUT_SECONDS=180
OCR_DPI=300

# --- Optional AI. AI_PROVIDER = none | ollama | groq ---
# none   = rules and OCR only
# ollama = local model, document text never leaves this PC
# groq   = fast cloud API; each job must be explicitly authorised in the UI before text is sent
AI_PROVIDER=none
AI_TIMEOUT_SECONDS=90
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b-fast
# Groq (cloud). Create a key at console.groq.com. Keep it in .env; never commit it.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
